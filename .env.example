# database
DATABASE_URL=postgres://arcade:arcade@localhost:5432/arcade
POSTGRES_PASSWORD=arcade

# secrets (development-only placeholders; regenerate for production)
DEVICE_TOKEN_SECRET=dev-device-secret-change-me
SESSION_SECRET=dev-session-secret-change-me
IP_HASH_SALT=dev-salt-change-me

# admin session
SESSION_TTL_HOURS=12
# set to 1 in production (HTTPS) so the session cookie is Secure-only
SESSION_COOKIE_SECURE=0

# admin seed account (dev only — change or remove for production seeding)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me-please

# runtime
NODE_ENV=development
TRUST_PROXY=0
PORT=3000

# manual re-join cooldown (CLAUDE.md §6 domain rule). Seconds a device must wait after
# being marked done before it can *manually* re-join the same game that day; a violation
# returns HTTP 409 code `rejoin_cooldown` (distinct from the 429 `rate_limited` tiers
# below). Auto re-queue is exempt. Set to 0 to disable.
REJOIN_COOLDOWN_SECONDS=30

# enqueue rate limits (CLAUDE.md §6 production posture — these are also the code defaults).
# The transport tier is per IP; the device tier is per device token in the domain service.
# On localhost every request shares one IP, so loosen ENQUEUE_IP_LIMIT (e.g. 60) while
# testing or the fourth join in a minute returns 429 / rate_limited.
ENQUEUE_IP_LIMIT=3
ENQUEUE_IP_TTL_SECONDS=60
ENQUEUE_DEVICE_LIMIT=1
ENQUEUE_DEVICE_TTL_SECONDS=5

# read/SSE rate limit, per IP (CLAUDE.md §6 production posture — also the code default).
# Board GETs and each SSE (re)connect count against it. When testing across devices on
# one Wi-Fi they share one IP bucket (all proxied from loopback via Vite), so raise
# READ_IP_LIMIT (e.g. 600) locally or a few reloads exhaust it and return 429.
READ_IP_LIMIT=60
READ_IP_TTL_SECONDS=60

# concurrent SSE streams per IP (CLAUDE.md §6 production posture — also the code default).
# In dev every device shares one IP through the Vite proxy, so raise this (e.g. 50) to
# watch live updates on your phone and laptop at once; otherwise only one connects.
MAX_STREAMS_PER_IP=3

# Vite development server
VITE_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:3000
