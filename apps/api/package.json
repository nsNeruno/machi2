{
  "name": "@machi2/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && concurrently --kill-others \"tsc -p tsconfig.build.json --watch\" \"node --watch dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --config vitest.config.ts",
    "test:api": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/scripts/migrate.ts",
    "db:seed": "tsx src/db/scripts/seed.ts"
  },
  "dependencies": {
    "@machi2/shared": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "argon2": "^0.45.0",
    "drizzle-orm": "^0.45.0",
    "dotenv": "^16.0.0",
    "fastify": "^5.0.0",
    "postgres": "^3.4.0",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0"
  }
}
